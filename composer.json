{
    "name": "kode/database",
    "description": "轻量级数据库适配器，ORM 无关设计：可自由选用 Laravel / ThinkPHP / Symfony(Doctrine) / Hyperf ORM，支持多数据库连接、读写分离、分库分表、连接池、协程、事件监听、Schema 与迁移",
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.15.0",
    "autoload": {
        "psr-4": {
            "Kode\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Database\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "illuminate/database": "Laravel ORM（illuminate/database 或 laravel/framework），driver=laravel 时使用其连接管理器",
        "topthink/think-orm": "ThinkPHP ORM（thinkphp/framework），driver=thinkphp 时使用其连接管理器",
        "doctrine/dbal": "Symfony 体系底层数据库抽象层（doctrine/dbal），driver=symfony 时使用",
        "symfony/orm": "Symfony ORM 生态（基于 Doctrine），与 driver=symfony 配合",
        "hyperf/database": "Hyperf ORM（hyperf/database），driver=hyperf 时使用",
        "kode/di": "依赖注入容器",
        "kode/context": "协程/进程上下文传递",
        "kode/fibers": "Fiber 协程支持",
        "kode/parallel": "并行查询支持",
        "kode/process": "进程池支持",
        "kode/cache": "查询结果缓存",
        "kode/event": "事件监听",
        "kode/exception": "统一异常处理",
        "kode/runtime": "多运行时抽象"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "database",
        "orm",
        "adapter",
        "laravel",
        "thinkphp",
        "hyperf",
        "swoole",
        "webman",
        "fiber",
        "coroutine",
        "php8",
        "kode"
    ]
}
